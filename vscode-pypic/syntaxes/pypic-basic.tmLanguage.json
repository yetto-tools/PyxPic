{
  "scopeName": "source.pypic-basic",
  "name": "PyPIC BASIC",
  "patterns": [
    { "name": "comment.line.apostrophe.pypic-basic", "match": "'.*$" },
    { "name": "comment.line.semicolon.pypic-basic", "match": ";.*$" },
    { "name": "string.quoted.double.pypic-basic", "begin": "\"", "end": "\"|$", "patterns": [{ "name": "constant.character.escape.pypic-basic", "match": "\\\\[nrt0\\\\\"']" }] },
    { "name": "constant.numeric.hex.pypic-basic", "match": "(?i)(\\$|0x)[0-9a-f_]+\\b" },
    { "name": "constant.numeric.binary.pypic-basic", "match": "%[01_]+\\b" },
    { "name": "constant.numeric.decimal.pypic-basic", "match": "\\b[0-9][0-9_]*\\b" },
    { "name": "entity.name.label.pypic-basic", "match": "^\\s*[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)" },
    { "name": "keyword.control.pypic-basic", "match": "(?i)\\b(if|then|else|elseif|endif|end\\s+if|for|to|step|next|do|loop|while|wend|until|select|case|end\\s+select|goto|gosub|return|exit|end)\\b" },
    { "name": "keyword.declaration.pypic-basic", "match": "(?i)\\b(device|clock|symbol|dim|as|let|from|import)\\b" },
    { "name": "storage.type.pypic-basic", "match": "(?i)\\b(byte|word|bit)\\b" },
    { "name": "support.function.command.pypic-basic", "match": "(?i)\\b(high|low|toggle|output|input|pause|pauseus|readadc|readadc10|read|write|pwmout|sertxd|serrxd)\\b" },
    { "name": "keyword.operator.word.pypic-basic", "match": "(?i)\\b(and|or|xor|not|mod)\\b" },
    { "name": "constant.language.clock.pypic-basic", "match": "(?i)\\b(internal|crystal|external|mhz|khz|hz)\\b" },
    { "name": "constant.language.pin.pypic-basic", "match": "(?i)\\b(pin)?[a-e]\\.[0-7]\\b" },
    { "name": "support.variable.pypic-basic", "match": "(?i)\\b[bw][0-9]{1,2}\\b" },
    { "name": "support.class.sdk.pypic-basic", "match": "(?i)\\b(adc|uart|eeprom|pwm[12]|cmp[12]|cvref|tmr[012])\\b" },
    { "name": "support.constant.sdk.pypic-basic", "match": "\\b(AN[0-9]+|FOSC_[0-9]+|FRC|C12IN[0-3]|REF_(PIN|CVREF|FIXED))\\b" },
    { "name": "keyword.operator.pypic-basic", "match": "<<|>>|<>|<=|>=|[-+*/%&|^~=<>#]" }
  ]
}
