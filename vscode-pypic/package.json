{
  "name": "pypic-ide",
  "displayName": "PyPIC IDE",
  "description": "v0.1.17 · Comprueba y compila programas PyPIC desde VS Code.",
  "version": "0.1.17",
  "publisher": "pypic",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/yetto-tools/PyPic.git" },
  "files": ["extension.js", "language.js", "pinout.js", "resources.js", "project.js", "projectmode.js", "sidebar.js", "welcome.js", "README.md", "LICENSE", "media", "syntaxes"],
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "scripts": { "test": "node --test test/commands.test.js test/projectmode.test.js test/pinout.test.js test/resources.test.js" },
  "activationEvents": ["onView:pypic.actions", "onView:pypic.resources", "onView:pypic.pinout", "onLanguage:python", "onLanguage:pypic", "workspaceContains:pypic.toml"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": {
    "languages": [{ "id": "pypic", "aliases": ["PyPIC"] }],
    "grammars": [{ "language": "pypic", "scopeName": "source.pypic", "path": "./syntaxes/pypic.tmLanguage.json" }],
    "viewsContainers": { "activitybar": [
      { "id": "pypic", "title": "PyPIC", "icon": "media/pypic.svg" }
    ] },
    "views": { "pypic": [
      { "id": "pypic.actions", "name": "Acciones" },
      { "id": "pypic.resources", "name": "Recursos", "type": "webview" },
      { "id": "pypic.pinout", "name": "Pinout", "type": "webview" }
    ] },
    "commands": [
      { "command": "pypic.check", "title": "PyPIC: Verificar código", "icon": "$(check)" },
      { "command": "pypic.build", "title": "PyPIC: Compilar archivo a HEX", "icon": "$(tools)" },
      { "command": "pypic.clean", "title": "PyPIC: Limpiar compilación", "icon": "$(trash)" },
      { "command": "pypic.examples", "title": "PyPIC: Abrir ejemplo" },
      { "command": "pypic.welcome", "title": "PyPIC: Abrir inicio" },
      { "command": "pypic.newProject", "title": "PyPIC: Crear proyecto" },
      { "command": "pypic.openProject", "title": "PyPIC: Abrir proyecto" },
      { "command": "pypic.openFile", "title": "PyPIC: Abrir archivo" },
      { "command": "pypic.pinout", "title": "PyPIC: Ver pinout" },
      { "command": "pypic.selectTarget", "title": "PyPIC: Perfil de destino" },
      { "command": "pypic.projectCheck", "title": "PyPIC: Revisar proyecto" },
      { "command": "pypic.mode", "title": "PyPIC: Archivo suelto o proyecto" },
      { "command": "pypic.status", "title": "PyPIC: Estado y ayuda" },
      { "command": "pypic.selectCompiler", "title": "PyPIC: Seleccionar compilador" },
      { "command": "pypic.selectDevices", "title": "PyPIC: Seleccionar Device Packs" },
      { "command": "pypic.selectPicAs", "title": "PyPIC: Seleccionar PIC-AS (opcional)" }
    ],
    "menus": { "editor/title": [
      { "command": "pypic.check", "when": "resourceLangId == python || resourceLangId == pypic", "group": "navigation" },
      { "command": "pypic.build", "when": "resourceLangId == python || resourceLangId == pypic", "group": "navigation" },
      { "command": "pypic.clean", "when": "resourceLangId == python || resourceLangId == pypic", "group": "navigation" }
    ],
    "view/title": [
      { "command": "pypic.check", "when": "view == pypic.actions", "group": "navigation@1" },
      { "command": "pypic.build", "when": "view == pypic.actions", "group": "navigation@2" },
      { "command": "pypic.clean", "when": "view == pypic.actions", "group": "navigation@3" }
    ] },
    "configuration": {
      "title": "PyPIC",
      "properties": {
        "pypic.executable": { "type": "string", "default": "pypic", "description": "Ruta al ejecutable de PyPIC." },
        "pypic.devicesDir": { "type": "string", "default": "", "description": "Directorio de Device Packs; vacío usa la búsqueda de PyPIC." },
        "pypic.picAsPath": { "type": "string", "default": "", "description": "Ruta opcional a PIC-AS. Informativa: la extensión todavía no ejecuta PIC-AS." },
        "pypic.checkOnSave": { "type": "boolean", "default": true, "description": "Comprueba archivos PyPIC guardados y actualiza Problemas." }
      }
    }
  }
}
